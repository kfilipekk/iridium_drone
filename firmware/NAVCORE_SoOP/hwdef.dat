# hwdef for NAVCORE-SoOP
# Generated by tools/gen_hwdef.py from the vendored MatekH743 reference plus the deltas below.
# hw definition file for processing by chibios_pins.py
# for NAVCORE-SoOP (45 x 47 mm, 30.5 mm stack)

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_NAVCORE_SOOP    # 9001, unregistered

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# bootloader takes first sector
FLASH_RESERVE_START_KB 128


# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 for IMU1 (MPU6000)
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
PC15 IMU1_CS CS

# SPI2 for MAX7456 OSD
# [removed: no analogue OSD fitted] PB12 MAX7456_CS CS
# [removed: SPI2 served only the analogue OSD, which is not fitted] PB13 SPI2_SCK SPI2
# [removed: SPI2 served only the analogue OSD, which is not fitted] PB14 SPI2_MISO SPI2
# [removed: SPI2 served only the analogue OSD, which is not fitted] PB15 SPI2_MOSI SPI2

# SPI3 - external
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3

# external CS pins
PD4 EXT_CS1 CS
PE2 EXT_CS2 CS

# SPI4 for IMU2 (ICM20602)
PE11 IMU2_CS CS
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4

# add ICM42605 on SPI4 as a backup to replace ICM20602
PC13 IMU3_CS CS

# two I2C bus
I2C_ORDER I2C2 I2C1

# I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# ADC
# [was: PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)]
# Battery sensing moves to ADC3 (PC0 is ADC123_INP10, the same channel
# number), so ADC1 and ADC2 are free to sample the tuner's I and Q together -
# AP_SoOP_Capture.
PC0 BATT_VOLTAGE_SENS ADC3 SCALE(1)
# [was: PC1 BATT_CURRENT_SENS ADC1 SCALE(1)]
# Battery current moves to ADC3 with the voltage (PC1 is ADC123_INP11).
PC1 BATT_CURRENT_SENS ADC3 SCALE(1)
# [removed: single battery; freed for the SoOP I/Q input] PA4 BATT2_VOLTAGE_SENS ADC1 SCALE(1)
# [was: PA7 BATT2_CURRENT_SENS ADC1 SCALE(1)]
# MatekH743 reads PA7 as BATT2_CURRENT_SENS. This board has one battery, so
# the pin was free, and it now drives Q3's gate to switch the 5 V Payload rail
# (U20). LOW leaves the rail enabled - R45 pulls the gate down as well - so
# payload fails safe towards powered. It is deliberately a pin MatekH743 only
# ever READS: a stock MatekH743 binary cannot assert it and so cannot cut
# payload power.
PA7 PAYLOAD_EN OUTPUT LOW GPIO(83)

define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
# [removed: single battery] define HAL_BATT2_VOLT_PIN 18
# [removed: single battery] define HAL_BATT2_CURR_PIN 7
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 40.0
# [removed: single battery] define HAL_BATT2_VOLT_SCALE 11.0

# [was: PC4 PRESSURE_SENS ADC1 SCALE(2)]
# No airspeed sensor: PC4 is the tuner's I, through the OPA2374 stage.
# Declared on ADC1 so the DMA resolver gives ADC1/ADC2 a stream of their own;
# AnalogIn leaves ADC1 alone (tools/install_soop_backend.py) and
# AP_SoOP_Capture samples it with Q on ADC2.
PC4 SOOP_I_ADC ADC1 SCALE(1)
# [removed: no airspeed sensor] define HAL_DEFAULT_AIRSPEED_PIN 4

# [was: PC5 RSSI_ADC ADC1]
# RSSI arrives over CRSF, so PC5 enables U24, the antenna's bias feed. HIGH,
# and R59 pulls it up, so the feed is on from power-up; AP_SoOP switches it
# off on a lasting short or when soop.cfg says ant_feed 0.
PC5 BIAS_EN OUTPUT HIGH GPIO(84)
# [removed: RSSI arrives over CRSF] define BOARD_RSSI_ANA_PIN 8

# LED
# green LED1 marked as B/E
# blue LED0 marked as ACT
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PE3 LED0 OUTPUT LOW GPIO(90) # blue
PE4 LED1 OUTPUT LOW GPIO(91) # green
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# order of UARTs (and USB)
SERIAL_ORDER OTG1 UART7 USART1 USART2 USART3 UART8 UART4 USART6 OTG2

# USART1 (telem2)
PA10 USART1_RX USART1
PA9  USART1_TX USART1

# USART2 (GPS1)
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# USART3 (GPS2)
PD9 USART3_RX USART3
PD8 USART3_TX USART3

# UART4 (spare)
PB9 UART4_TX UART4
PB8 UART4_RX UART4

# USART6 (RC input), SERIAL7
# [removed: RC is CRSF over USART6 (SERIAL7_PROTOCOL 23), so the timer input on the same pin goes, and TIM3 drives M1/M2 instead (PPM/SBUS-by-timer receivers lose their input)] PC7 TIM3_CH2 TIM3 RCININT PULLDOWN LOW
PC6 USART6_TX USART6 NODMA

# as an alternative config setup the RX6 pin as a uart. This allows
# for bi-directional UART based receiver protocols such as FPort
# without any extra hardware
# [was: PC7 USART6_RX USART6 NODMA ALT(1)]
# USART6_RX is PC7's only function now that the timer RC input is gone.
PC7 USART6_RX USART6 NODMA

# UART7 (telem1)
PE7 UART7_RX UART7
PE8 UART7_TX UART7
PE10 UART7_CTS UART7
PE9  UART7_RTS UART7

# UART8 (spare)
PE0 UART8_RX UART8
# [removed: ESC telemetry is receive-only, so UART8 needs only PE0/RX. PE1 is left unwired rather than declared and unconnected] PE1 UART8_TX UART8

# CAN bus
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PD3 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)

# Motors
# [was: PB0  TIM8_CH2N TIM8  PWM(1)  GPIO(50)]
# M1 moves from TIM8_CH2N (complementary - no input capture, so no BDShot) to
# TIM3_CH3 on the same pin, as MatekH743-bdshot does. BIDIR is set on the
# first channel of each pair, which reads for both.
PB0  TIM3_CH3 TIM3  PWM(1)  GPIO(50) BIDIR
# [was: PB1  TIM8_CH3N TIM8  PWM(2)  GPIO(51)]
# M2: TIM3_CH4, same pin.
PB1  TIM3_CH4 TIM3  PWM(2)  GPIO(51)
# [was: PA0  TIM5_CH1  TIM5  PWM(3)  GPIO(52)]
# M3/M4 stay on TIM5 (MatekH743-bdshot moves them to TIM2, but TIM2_CH1 is the
# passive buzzer's tone on PA15).
PA0  TIM5_CH1  TIM5  PWM(3)  GPIO(52) BIDIR
PA1  TIM5_CH2  TIM5  PWM(4)  GPIO(53)
PA2  TIM5_CH3  TIM5  PWM(5)  GPIO(54)
PA3  TIM5_CH4  TIM5  PWM(6)  GPIO(55)
PD12 TIM4_CH1 TIM4 PWM(7) GPIO(56)
PD13 TIM4_CH2 TIM4 PWM(8) GPIO(57)
PD14 TIM4_CH3 TIM4 PWM(9) GPIO(58)
PD15 TIM4_CH4 TIM4 PWM(10) GPIO(59)
PE5  TIM15_CH1 TIM15 PWM(11) GPIO(60)
PE6  TIM15_CH2 TIM15 PWM(12) GPIO(61)
PA8 TIM1_CH1 TIM1 PWM(13) GPIO(62) # for WS2812 LED

# Beeper
PA15 TIM2_CH1 TIM2 GPIO(32) ALARM

# microSD support
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# GPIOs
# [was: PD10  PINIO1 OUTPUT GPIO(81) LOW]
# U24's FAULT#, open drain, pulled up by R60: low on overcurrent,
# overtemperature or reverse voltage.
PD10 BIAS_FAULT INPUT GPIO(85)
# [was: PD11  PINIO2 OUTPUT GPIO(82) LOW]
# PD11 is reserved for an optical flow motion interrupt. It is not wired on
# Rev C (J14.6 is GND), so the pull-down holds it idle.
PD11 FLOW_MOTION INPUT PULLDOWN GPIO(86)

DMA_PRIORITY S*

define HAL_STORAGE_SIZE 32768

# use last 2 pages for flash storage
# H743 has 16 pages of 128k each
STORAGE_FLASH_PAGE 14

# spi devices
SPIDEV icm42688  SPI1 DEVID1 IMU1_CS      MODE3  2*MHZ 16*MHZ   # Clock is 100Mhz so highest clock <= 24Mhz is 100Mhz/8
# [removed: MPU6000 not fitted] SPIDEV mpu6000   SPI1 DEVID1 IMU1_CS      MODE3  1*MHZ  4*MHZ
# [removed: ICM-20602 not fitted] SPIDEV icm20602  SPI4 DEVID1 IMU2_CS      MODE3  1*MHZ  4*MHZ
# [was: SPIDEV icm42605  SPI4 DEVID1 IMU3_CS      MODE3  2*MHZ 16*MHZ]
# U3's CS pad is wired to PE11 (IMU2_CS), read from the board.
SPIDEV icm42605  SPI4 DEVID1 IMU2_CS      MODE3  2*MHZ 16*MHZ
# [removed: no analogue OSD fitted] SPIDEV osd       SPI2 DEVID4 MAX7456_CS   MODE0 10*MHZ 10*MHZ


# [was: DMA_NOSHARE SPI1* SPI4*]
# the BDShot timers get DMA streams of their own, as the IMU buses do
DMA_NOSHARE SPI1* SPI4* TIM3* TIM5*

# SPI3 external connections
SPIDEV pixartflow   SPI3 DEVID1  EXT_CS1  MODE3   2*MHZ  2*MHZ

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# two IMUs
# H743-V1,      ICM20602, MPU6000
# H743-V1.5/V2, ICM42605, MPU6000
# H743-V3,      ICM42688P, ICM42605
IMU Invensensev3 SPI:icm42688 ROTATION_YAW_180    # U2, from its pads; forward is the bottom edge
IMU Invensensev3 SPI:icm42605 ROTATION_YAW_90    # U3, from its pads; forward is the bottom edge
# [removed: ICM-20602 not fitted] IMU Invensense SPI:icm20602 ROTATION_ROLL_180_YAW_270
# [removed: MPU6000 not fitted] IMU Invensense SPI:mpu6000 ROTATION_ROLL_180_YAW_270
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# DPS310 integrated on I2C2 bus, multiple possible choices for external barometer
BARO MS5611 I2C:0:0x77
# [removed: DPS310 is not stocked at LCSC; MS5611 fitted] BARO DPS310 I2C:0:0x76
# [removed: BMP280 not fitted] BARO BMP280 I2C:0:0x76

define HAL_OS_FATFS_IO 1

# setup for OSD
# [removed: no analogue OSD fitted] define OSD_ENABLED 1
# [removed: no analogue OSD fitted] define HAL_OSD_TYPE_DEFAULT 1
# [removed: no analogue OSD fitted] ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

# build ABIN for flash-from-bootloader support:
env BUILD_ABIN True


# W25Q128 on SPI3 EXT_CS2 - holds the Iridium TLE catalogue, not firmware.
SPIDEV tle_flash  SPI3 DEVID2 EXT_CS2 MODE3 8*MHZ 32*MHZ

# No on-board compass by design: a magnetometer 15 mm from a 60 A 4-in-1 ESC is
# useless. I2C1 is on the GPS connector - use the compass inside the GPS module.
define ALLOW_ARM_NO_COMPASS 1

# U19, the TMP119 beside U9, needs this line or it is dead SILICON.
define AP_TEMPERATURE_SENSOR_ENABLED 1

# ADC1 samples the tuner's I (PC4, INP4) and ADC2 its Q (PA4, INP18) at the same instant, in
# dual regular-simultaneous mode, for the on-board Iridium navigation (AP_SoOP_Capture).
# Dual mode needs 32-bit ADC12 samples; the battery is on ADC3, above.
define STM32_ADC_DUAL_MODE TRUE
define STM32_ADC_SAMPLES_SIZE 32
define HAL_SOOP_CAPTURE_ENABLED 1

# The antenna feed's current: U25 (INA180A2, x50) across R62 (2R2 ohm), on PC2_C.
# PC2_C reaches ADC3_INP0 with its analogue switch open; AP_SoOP opens it (SYSCFG PMCR).
PC2 ANT_CURRENT ADC3 SCALE(1)
define HAL_SOOP_ANT_ADC_PIN 0
define HAL_SOOP_ANT_SENSE_OHM 2.2f
define HAL_SOOP_ANT_GAIN 50.0f
define HAL_SOOP_ANT_EN_GPIO 84
define HAL_SOOP_ANT_FAULT_GPIO 85

