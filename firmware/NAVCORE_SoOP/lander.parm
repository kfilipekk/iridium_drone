#NAVCORE-SoOP Revision D lander profile, not the multirotor defaults.parm

FRAME_CLASS 9
FRAME_TYPE 1
MOT_PWM_TYPE 6

#AP_MotorsCoax drives motor functions 5/6 as the two lift motors
SERVO1_FUNCTION 37
SERVO2_FUNCTION 38
#actuator functions for the coax roll/pitch flap pairs
SERVO7_FUNCTION 33
SERVO8_FUNCTION 34

#Rev C removed the touchdown input (PD10) and the pyro channel (PC5) from the board
CHUTE_ENABLED 0
CHUTE_TYPE 0
CHUTE_ALT_MIN 10

#never require a safety button that this board does not fit
BRD_SAFETY_DEFLT 0

