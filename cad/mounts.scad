module iridium_antenna() {          // Tallysman HC610: radome over the helix, SMA below
    translate([0, helix_y, seat_z]) {
        color("#2b2b2b") cylinder(d1 = 33.3, d2 = 28.5, h = 54.2, $fn = 48);
        color("#c8b070") translate([0, 0, -10]) cylinder(d = 8, h = 10, $fn = 24);
    }
