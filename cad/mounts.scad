module bias_tee() {
    translate([0, bias_y, seat_z]) {
        color("#9aa0a6") box(-21.0, 21.0, -16.0, 16.0, 0, 12.0);
        color("#c8b070") for (s = [-1, 1]) translate([s * 21.0, 0, 6.0])
            rotate([0, s * 90, 0]) cylinder(d = 6.5, h = 8, $fn = 24);
