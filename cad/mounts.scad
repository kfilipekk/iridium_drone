// ---- lidar bracket: the LD06, upside down under the bottom plate ------------------------
// Hangs from the two forward rear-post screws (into the 30 mm standoffs) and the front
// pair of the 20x20 M2 holes; the heads sit in counterbores because the lidar covers them.
lidar_bracket_t = 5.0;
lidar_y         = 24.0;
module lidar_bracket() {
    t = 5.0; cb = 3.2;
    color("#d9822b") difference() {
        box(-22.0, 22.0, 3.0, 48.0, -t, 0);
        for (p = [[-14.6, 27.88], [14.6, 27.88]]) translate([p[0], p[1], -t]) { hole(3.4, t); translate([0, 0, -1]) cylinder(d = 6.0, h = cb + 1, $fn = 24); }
        for (p = [[-10.0, 43.5], [10.0, 43.5]]) translate([p[0], p[1], -t]) { hole(2.4, t); translate([0, 0, -1]) cylinder(d = 4.2, h = cb + 1, $fn = 24); }
        // the LD06's two diagonal M2.5 holes, screwed from the lidar's side
        for (s = [-1, 1]) translate([s * 14.1, lidar_y - s * 14.1, -t]) bore(ins_m25, false);
    }
}
module lidar360() {
    translate([0, lidar_y, -lidar_bracket_t - 33.3]) color("#3b4048")
        linear_extrude(33.3) offset(r = 2) square([34.59, 34.59], center = true);
}

// ---- downward rangefinder cradle: the TFS20-L, under the bottom plate -------------------
// Two M2 through the lid, the cradle and the plate, nuts on top: the sensor has no holes,
// so the lid pins it in its pocket.
range_y      = 63.5;
range_body_h = 9.67;
module range_cradle() {
    hx = 14.0; hy = 13.0; px = 7.7; py = 10.7;
    color("#d9822b") translate([0, range_y, -range_body_h]) difference() {
        box(-hx, hx, -hy, hy, 0, range_body_h);
        box(-px, px, -py, py, -1, range_body_h - 1.5);
        box(-2.5, 2.5, py - 0.01, hy + 0.01, 0, 3);             // the lead's exit
        for (h = [[-10.0, 63.5], [10.0, 63.5]]) translate([h[0], h[1] - range_y, 0]) hole(2.4, range_body_h);
    }
}
module range_lid() {
    hx = 14.0; hy = 13.0;
    color("#e0a050") translate([0, range_y, -range_body_h - 1.5]) difference() {
        box(-hx, hx, -hy, hy, 0, 1.5);
        box(-5, 5, -8, 8, -1, 1.5 + 1);                 // the optics' window
        for (h = [[-10.0, 63.5], [10.0, 63.5]]) translate([h[0], h[1] - range_y, 0]) hole(2.4, 1.5);
    }
}
module belly_sensor() {
    translate([0, range_y, -1.5 - 7.87]) color("#2a2f36")
        box(-7.5, 7.5, -10.5, 10.5, 0, 7.87);
}

module mounts() {
    antenna_tower(); gps_pod(); gps_lid(); bias_strap(); nose_mount(); xiao_lid(); rx_cover();
    lidar_bracket();
    range_cradle(); range_lid();
}
module mounted_parts() {
    gps(); iridium_antenna(); bias_tee(); rx(); elrs_antennas();
}

// ---- laid out for printing: each part on the bed, in the orientation it prints ---------
module print_antenna_tower() { translate([0, 0, seat_z]) rotate([180, 0, 0]) antenna_tower(); }
module print_gps_pod()       { translate([0, 0, -seat_z]) gps_pod(); }
module print_gps_lid()       { translate([0, 0, pod_top_z + 6.4]) rotate([180, 0, 0]) gps_lid(); }
module print_bias_strap()    { translate([0, 0, seat_z + 15.3]) rotate([180, 0, 0]) bias_strap(); }
module print_nose_mount()    { translate([0, 0, nose_z]) rotate([180, 0, 0]) nose_mount(); }
module print_xiao_lid()      { translate([0, 0, -(cam_bot - 2.0)]) xiao_lid(); }
module print_rx_cover()      { translate([0, 0, -(rx_bot - 1.5)]) rx_cover(); }
module print_lidar_bracket() { translate([0, 0, lidar_bracket_t]) lidar_bracket(); }
module print_range_cradle()  { rotate([180, 0, 0]) range_cradle(); }
module print_range_lid()     { translate([0, 0, range_body_h + 1.5]) range_lid(); }
